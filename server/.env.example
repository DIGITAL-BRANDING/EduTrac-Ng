# Server
# Railway sets PORT automatically - do not override it in Railway env vars.
PORT=5000

# Required in production. Comma-separate multiple origins if needed.
# Example: https://edutrac.netlify.app,https://yourdomain.com
CLIENT_ORIGIN=https://your-netlify-site.netlify.app

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic AI chat proxy
ANTHROPIC_API_KEY=

# OpenAI lesson generator
OPENAI_API_KEY=
OPENAI_LESSON_MODEL=gpt-4o-mini
