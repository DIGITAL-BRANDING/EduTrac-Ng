diff --git a/supabase/migrations/0001_multi_role_support.sql b/supabase/migrations/0001_multi_role_support.sql
new file mode 100644
index 0000000..b134dd7
--- /dev/null
+++ b/supabase/migrations/0001_multi_role_support.sql
@@ -0,0 +1,90 @@
+-- ============================================================
+--  EduTrack NG — Multi-Role Support Migration
+--  Replaces the insecure client-side "impersonation" hack with
+--  a safe, server-verified way for one staff member to hold
+--  several roles (common in small schools where one person is
+--  Admin + Exam Officer + Registrar, etc.)
+--
+--  Run this in Supabase Dashboard → SQL Editor (or via CLI:
+--  supabase db push) BEFORE deploying the updated client code.
+-- ============================================================
+
+-- 1. Add a `roles` array column. `role` stays as-is and now means
+--    "currently active role" — i.e. which portal/menu the user is
+--    currently viewing. It must always be one of the values in `roles`.
+alter table public.users
+  add column if not exists roles text[] not null default '{}';
+
+-- 2. Backfill: every existing user's `roles` becomes a single-item
+--    array containing their current `role`, so nothing breaks.
+update public.users
+  set roles = array[role]
+  where roles = '{}' and role is not null;
+
+-- 3. Keep data consistent going forward: whenever `role` is set/changed
+--    directly (e.g. by admin editing a staff record), make sure it's
+--    always included in `roles` too, so the invariant "role ⊆ roles"
+--    never breaks even from direct table edits.
+create or replace function public._sync_role_into_roles()
+returns trigger
+language plpgsql
+as $$
+begin
+  if new.role is not null and not (new.role = any(coalesce(new.roles, '{}'))) then
+    new.roles := array_append(coalesce(new.roles, '{}'), new.role);
+  end if;
+  return new;
+end;
+$$;
+
+drop trigger if exists trg_sync_role_into_roles on public.users;
+create trigger trg_sync_role_into_roles
+  before insert or update of role, roles on public.users
+  for each row
+  execute function public._sync_role_into_roles();
+
+-- 4. Safe, server-verified role switch.
+--    - Always operates on the CALLER's own row (auth.uid()) — a user
+--      can never switch another user's active role.
+--    - Only allows switching to a role already present in the
+--      caller's own `roles` array — never an arbitrary role.
+--    - This fully replaces the old impersonate.js approach, which
+--      let anyone view/act as any other user via a URL parameter
+--      with no server-side check at all.
+create or replace function public.switch_active_role(new_role text)
+returns public.users
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  updated_row public.users;
+begin
+  if not exists (
+    select 1 from public.users
+    where id = auth.uid()
+      and new_role = any(roles)
+  ) then
+    raise exception 'Role "%" is not assigned to this account', new_role
+      using errcode = '42501';
+  end if;
+
+  update public.users
+    set role = new_role
+    where id = auth.uid()
+    returning * into updated_row;
+
+  return updated_row;
+end;
+$$;
+
+-- Only the authenticated user may call this, and only for themselves.
+revoke all on function public.switch_active_role(text) from public;
+grant execute on function public.switch_active_role(text) to authenticated;
+
+-- 5. Sanity view for admins to see who holds multiple roles
+--    (handy for auditing after rollout).
+create or replace view public.v_multi_role_staff as
+select id, school_id, full_name, role as active_role, roles
+from public.users
+where array_length(roles, 1) > 1;
diff --git a/supabase/migrations/0002_fix_anon_rls_leaks.sql b/supabase/migrations/0002_fix_anon_rls_leaks.sql
new file mode 100644
index 0000000..1fec0c8
--- /dev/null
+++ b/supabase/migrations/0002_fix_anon_rls_leaks.sql
@@ -0,0 +1,172 @@
+-- ============================================================
+--  EduTrack NG — Fix Overly-Permissive Anonymous RLS Policies
+--
+--  Found via live audit (Aug 2026): several tables had a SELECT
+--  (and in one case UPDATE) policy for the `anon` role with
+--  `USING (true)` or an effectively-always-true condition,
+--  exposing full cross-tenant data to anyone with just the
+--  public anon key — no login required. Confirmed exploitable
+--  on `students` (full name + school_id dump across schools).
+--
+--  Fix strategy: replace every `true`/near-true anon policy with
+--  the SAME safe, already-proven pattern used elsewhere in this
+--  project — scoping to `current_setting('app.school_id')`,
+--  which is only set (per-request) by a trusted SECURITY DEFINER
+--  RPC (e.g. use_scratch_card) after it has already verified a
+--  scratch-card PIN. Until that GUC is set, the condition is
+--  NULL and access is correctly denied by default.
+--
+--  IMPORTANT — verify BEFORE relying on this pattern anywhere:
+--  confirm `app.school_id` cannot be set directly by a client
+--  request header (Supabase Dashboard → Database → Roles/API →
+--  check for any custom GUC-to-header mapping / pre-request
+--  hook). If it can, this pattern is bypassable the same way the
+--  `true` policies were, just with one extra step.
+-- ============================================================
+
+-- ── CRITICAL: students ──────────────────────────────────────
+-- Confirmed exploited: returned full_name + school_id for
+-- students across 3+ schools with zero authentication.
+drop policy if exists "Allow public student verification" on public.students;
+
+create policy "students_anon_scoped" on public.students
+  for select to anon
+  using (
+    school_id = (current_setting('app.school_id', true))::uuid
+    and current_setting('app.school_id', true) is not null
+  );
+
+-- ── CRITICAL: student_applications ──────────────────────────
+-- Multiple duplicate/overlapping policies, effectively `true`.
+-- Worse: an UPDATE policy also allowed anon to modify ANY
+-- application, not just their own.
+drop policy if exists "anon_read_student_applications"   on public.student_applications;
+drop policy if exists "anon_track_by_ref"                on public.student_applications;
+drop policy if exists "student_applications_anon_select" on public.student_applications;
+drop policy if exists "anon_select_own_application"      on public.student_applications;
+drop policy if exists "anon_stamp_own_application"       on public.student_applications;
+
+-- Applicants track their OWN application only, via the unique
+-- reference code they were given at submission time — never a
+-- blanket listing. The tracking page must call this RPC first,
+-- which verifies the ref_id actually exists, then scopes this
+-- request to it. `select=*` with no ref_id known returns nothing.
+create or replace function public.open_application_tracking(p_ref text)
+returns boolean
+language plpgsql
+security definer
+set search_path = public
+as $$
+begin
+  if not exists (select 1 from public.student_applications where ref_id = p_ref) then
+    return false;
+  end if;
+  -- NOTE: is_local must match whatever `use_scratch_card` (or whichever
+  -- RPC currently sets app.school_id) already uses — check its source in
+  -- Supabase Dashboard → Database → Functions before assuming this value.
+  -- If it uses `false` (session-persistent, relies on a session-mode
+  -- pooler connection), use `false` here too; a mismatch will silently
+  -- break tracking (RPC succeeds, follow-up SELECT sees nothing).
+  perform set_config('app.tracking_ref', p_ref, true);
+  return true;
+end;
+$$;
+
+revoke all on function public.open_application_tracking(text) from public;
+grant execute on function public.open_application_tracking(text) to anon, authenticated;
+
+create policy "student_applications_anon_by_ref" on public.student_applications
+  for select to anon
+  using (
+    ref_id is not null
+    and ref_id = current_setting('app.tracking_ref', true)
+  );
+
+-- Anon may still SUBMIT a new application (that's the intended
+-- public flow) but may never blanket-UPDATE any application row.
+-- The submission page needs to attach a few extra fields
+-- (ref_id, intended_level/program/combo, photo_url) onto a row
+-- right after `submit_student_application` creates it — this RPC
+-- does that server-side, narrowly, instead of a blanket UPDATE
+-- policy. It only allows stamping a row that is still 'pending'
+-- and doesn't already have a ref_id, so it can't be used to
+-- tamper with an already-submitted or already-reviewed application.
+create or replace function public.stamp_application_details(
+  p_id uuid,
+  p_ref_id text,
+  p_intended_level text default null,
+  p_intended_program text default null,
+  p_intended_combo text default null,
+  p_photo_url text default null
+)
+returns boolean
+language plpgsql
+security definer
+set search_path = public
+as $$
+begin
+  update public.student_applications
+    set ref_id = p_ref_id,
+        intended_level = coalesce(p_intended_level, intended_level),
+        intended_program = coalesce(p_intended_program, intended_program),
+        intended_combo = coalesce(p_intended_combo, intended_combo),
+        photo_url = coalesce(p_photo_url, photo_url)
+    where id = p_id
+      and status = 'pending'
+      and ref_id is null;
+
+  return found;
+end;
+$$;
+
+revoke all on function public.stamp_application_details(uuid,text,text,text,text,text) from public;
+grant execute on function public.stamp_application_details(uuid,text,text,text,text,text) to anon, authenticated;
+
+-- ── CRITICAL: notifications ──────────────────────────────────
+drop policy if exists "notif_anon" on public.notifications;
+
+create policy "notifications_anon_scoped" on public.notifications
+  for select to anon
+  using (
+    school_id = (current_setting('app.school_id', true))::uuid
+    and current_setting('app.school_id', true) is not null
+  );
+
+-- ── CRITICAL: daily_activities ────────────────────────────────
+drop policy if exists "dact_anon_r" on public.daily_activities;
+
+create policy "daily_activities_anon_scoped" on public.daily_activities
+  for select to anon
+  using (
+    school_id = (current_setting('app.school_id', true))::uuid
+    and current_setting('app.school_id', true) is not null
+  );
+
+-- ── CRITICAL: installment_plans ───────────────────────────────
+drop policy if exists "inst_anon" on public.installment_plans;
+
+create policy "installment_plans_anon_scoped" on public.installment_plans
+  for select to anon
+  using (
+    school_id = (current_setting('app.school_id', true))::uuid
+    and current_setting('app.school_id', true) is not null
+  );
+
+-- ── MEDIUM: remove duplicate wide-open policies where a safer
+--    scoped policy for the same table already exists ──────────
+
+-- classes: keep "anon can read classes for active schools", drop the blanket one
+drop policy if exists "classes_anon_read" on public.classes;
+
+-- schools: keep "anon_read_school_name" / "anon can read active schools"
+-- (is_active = true), drop the unconditional duplicate
+drop policy if exists "schools_anon_read" on public.schools;
+
+-- terms: keep the JWT-claims-scoped "terms_anon", drop the blanket one
+drop policy if exists "terms_anon_read" on public.terms;
+
+-- ============================================================
+--  After running this: re-test the same curl commands used to
+--  find the original leak. GET /rest/v1/students with only the
+--  anon key should now return [] (empty), not student rows.
+-- ============================================================
